# Appy-UX Studio — Environment Variables Template
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# ── Project Identity ──
PROJECT_ID=appy-ux-studio
PROJECT_NAME="Appy-UX Studio"
TENANT_ID=agency

# ── Ports ──
BACKEND_PORT=8002
FRONTEND_PORT=5180
ADMIN_PORT=5181

# ── Database ──
DATABASE_URL=sqlite:///data/databases/appyux_agency.db

# ── Auth ──
JWT_SECRET=change-me-to-a-random-256-bit-key
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# ── Payments ──
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ── ComfyUI ──
COMFYUI_URL=http://localhost:8188
COMFYUI_OUTPUT_DIR=/path/to/comfyui/output

# ── Channels ──
FIVERR_API_KEY=your-fiverr-api-key
FIVERR_WEBHOOK_SECRET=your-fiverr-webhook-secret
UPWORK_API_KEY=your-upwork-api-key
UPWORK_WEBHOOK_SECRET=your-upwork-webhook-secret

# ── Storage ──
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── Email (optional) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Monitoring ──
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn (optional)
